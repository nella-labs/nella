diff --git a/prisma/schema.prisma b/prisma/schema.prisma
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -12,4 +12,5 @@ model users {
   email String  @db.VarChar(255)
   name  String  @db.VarChar(255)
   phone String? @db.VarChar(255)
+  deletedAt DateTime?
 }

diff --git a/src/modules/users/users.route.ts b/src/modules/users/users.route.ts
--- a/src/modules/users/users.route.ts
+++ b/src/modules/users/users.route.ts
@@ -35,4 +35,15 @@ users.post(
   controller.createUser
 );
 
+/**
+ * DELETE /users/{id}
+ * @summary Soft delete a user
+ * @tags Users
+ * @param {string} id.path.required - User ID
+ * @return {object} 200 - User deleted
+ * @return {object} 404 - User not found
+ */
+users.delete("/:id", verifyAuthToken, controller.deleteUser);
+
 export default users;

diff --git a/src/modules/users/users.controller.ts b/src/modules/users/users.controller.ts
--- a/src/modules/users/users.controller.ts
+++ b/src/modules/users/users.controller.ts
@@ -18,6 +18,19 @@ class UsersController {
     }
   };
 
+  public deleteUser = async (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const { id } = req.params;
+      const user = await this.usersService.softDeleteUser(id);
+      if (!user) {
+        return res.status(404).json({ success: false, message: "User not found" });
+      }
+      return res.status(200).json({ success: true, message: "User deleted" });
+    } catch (error) {
+      next(error);
+    }
+  };
+
 }
 
 export default UsersController;

diff --git a/src/modules/users/users.service.ts b/src/modules/users/users.service.ts
--- a/src/modules/users/users.service.ts
+++ b/src/modules/users/users.service.ts
@@ -8,6 +8,18 @@ class UsersService {
     return user;
   }
 
+  public async softDeleteUser(id: string) {
+    const user = await prisma.users.findFirst({
+      where: { id, deletedAt: null }
+    });
+    if (!user) return null;
+    
+    return prisma.users.update({
+      where: { id },
+      data: { deletedAt: new Date() }
+    });
+  }
+
 }
 
 export default UsersService;
