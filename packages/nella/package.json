{
  "name": "@usenella/nella",
  "version": "0.0.0",
  "description": "Nella - reliability layer for coding agents (CLI + MCP Server)",
  "type": "commonjs",
  "bin": {
    "nella": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "require": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "c8 --reporter=text --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "test:ci": "c8 --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "dev": "tsc --watch",
    "start:mcp": "node dist/mcp/server.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "cli",
    "mcp",
    "model-context-protocol",
    "reliability",
    "nella"
  ],
  "author": "Nella Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/usenella/nella.git",
    "directory": "packages/nella"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@supabase/supabase-js": "^2.39.0",
    "@usenella/core": "workspace:*",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.6.1",
    "figures": "^3.2.0",
    "ioredis": "^5.9.3",
    "js-yaml": "^4.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/figures": "^3.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.3.0"
  }
}
