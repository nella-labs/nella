{
  "name": "@usenella/core",
  "version": "0.0.0",
  "description": "Codebase intelligence for coding agents - grounded search, persistent context, assumption tracking, and dependency awareness",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "c8 --reporter=text --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "test:ci": "c8 --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "codebase-intelligence",
    "code-understanding",
    "context-tracking",
    "grounded-search"
  ],
  "author": "Nella Labs",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nella-labs/nella.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.7.0",
    "@msgpack/msgpack": "^3.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "@typescript-eslint/typescript-estree": "^7.0.0",
    "minimatch": "^10.2.4",
    "natural": "^6.10.0",
    "pg": "^8.11.0"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.18.0",
    "hnswlib-node": "^3.0.0",
    "ioredis": "^5.9.3",
    "onnxruntime-node": "^1.17.0",
    "usearch": "^2.21.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/natural": "^5.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
