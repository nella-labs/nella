{
  "name": "@usenella/api",
  "version": "0.0.0",
  "description": "REST API server for Nella — exposes workspace, search, validation, context, and auth endpoints",
  "type": "commonjs",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "test": "c8 --reporter=text --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "test:ci": "c8 --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nella",
    "api",
    "rest",
    "coding-agents",
    "validation",
    "safety"
  ],
  "author": "Nella Labs",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nella-labs/nella.git",
    "directory": "packages/api"
  },
  "dependencies": {
    "@usenella/core": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "express": "^4.18.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "zod": "^3.22.0",
    "ioredis": "^5.9.3",
    "ws": "^8.16.0",
    "pino": "^8.17.0",
    "bullmq": "^5.69.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/compression": "^1.7.0",
    "@types/ws": "^8.5.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
