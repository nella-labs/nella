{
  "name": "@usenella/benchmark",
  "version": "0.0.0",
  "description": "Benchmark suite for evaluating coding agents on capability and safety",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nella-benchmark": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "c8 --reporter=text --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "test:ci": "c8 --reporter=lcov --report-dir=coverage tsx --test src/**/__tests__/*.test.ts",
    "dev": "tsc --watch",
    "benchmark": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "benchmark",
    "coding-agents",
    "evaluation",
    "safety",
    "nella"
  ],
  "author": "Nella Labs",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nella-labs/nella.git",
    "directory": "packages/benchmark"
  },
  "dependencies": {
    "@usenella/core": "workspace:*",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "typescript": "^5.3.0"
  }
}
