# =============================================================================
# Nella Core - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Embedding Providers (at least one required for indexing)
# -----------------------------------------------------------------------------

# Voyage AI - Recommended for code embeddings
# Get your key at: https://www.voyageai.com/
VOYAGE_API_KEY=

# OpenAI - Alternative embedding provider
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cohere - Used for reranking search results (optional)
# Get your key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# -----------------------------------------------------------------------------
# Auth Module
# -----------------------------------------------------------------------------

# Master encryption key for encrypting stored API keys (32 bytes, base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NELLA_AUTH_ENCRYPTION_KEY=

# JWT signing secret (for session tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
NELLA_JWT_SECRET=

# JWT token expiry (default: 24h)
NELLA_JWT_EXPIRY=24h

# -----------------------------------------------------------------------------
# Cloud Sync - Supabase (Optional, for sync tier: supabase)
# -----------------------------------------------------------------------------

# Supabase project URL
# Find at: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=

# Supabase anonymous key (public, safe for client-side)
SUPABASE_ANON_KEY=

# Supabase service role key (secret, server-side only)
# WARNING: Never expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Cloud Sync - Google Cloud Platform (Optional, for sync tier: gcp)
# -----------------------------------------------------------------------------

# GCP Project ID
GCP_PROJECT_ID=

# Cloud SQL instance connection name (project:region:instance)
GCP_CLOUD_SQL_INSTANCE=

# Cloud SQL database credentials
GCP_DB_USER=
GCP_DB_PASSWORD=
GCP_DB_NAME=nella

# GCS bucket for index storage
GCP_STORAGE_BUCKET=

# Path to service account JSON key file (alternative to ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------

# Redis URL for distributed rate limiting (optional)
# If not set, uses in-memory rate limiting
REDIS_URL=

# -----------------------------------------------------------------------------
# Playground Server (Optional)
# -----------------------------------------------------------------------------

# Server port (default: 3000)
NELLA_PORT=3000

# Enable HTTPS (requires cert/key files)
NELLA_HTTPS_ENABLED=false
NELLA_HTTPS_CERT=
NELLA_HTTPS_KEY=

# -----------------------------------------------------------------------------
# Development / Debug
# -----------------------------------------------------------------------------

# Log level: debug, info, warn, error (default: info)
NELLA_LOG_LEVEL=info

# Enable debug mode (verbose logging, no minification)
NELLA_DEBUG=false
