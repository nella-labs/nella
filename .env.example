# =============================================================================
# Nella Core - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Azure OpenAI — Embeddings
# -----------------------------------------------------------------------------

AZURE_EMBEDDING_API_KEY=
AZURE_ENDPOINT=https://nella.cognitiveservices.azure.com
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# -----------------------------------------------------------------------------
# Azure AI Cohere — Reranking (separate MaaS deployment)
# -----------------------------------------------------------------------------

AZURE_RERANK_API_KEY=
AZURE_RERANK_ENDPOINT=https://nella.services.ai.azure.com/cohere/v2/rerank

# -----------------------------------------------------------------------------
# Auth Module
# -----------------------------------------------------------------------------

# Master encryption key for encrypting stored API keys (32 bytes, base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NELLA_AUTH_ENCRYPTION_KEY=

# JWT signing secret (for session tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
NELLA_JWT_SECRET=

# -----------------------------------------------------------------------------
# Cloud Sync - Supabase (Optional, for sync tier: supabase)
# -----------------------------------------------------------------------------

# Supabase project URL
# Find at: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=

# Supabase anonymous key (public, safe for client-side)
SUPABASE_ANON_KEY=

# Supabase service role key (secret, server-side only)
# WARNING: Never expose this in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Cloud Sync - Google Cloud Platform (Optional, for sync tier: gcp)
# -----------------------------------------------------------------------------

# GCP Project ID
GCP_PROJECT_ID=

# Cloud SQL instance connection name (project:region:instance)
GCP_CLOUD_SQL_INSTANCE=

# Cloud SQL database credentials
GCP_DB_USER=
GCP_DB_PASSWORD=
GCP_DB_NAME=nella

# GCS bucket for index storage
GCP_STORAGE_BUCKET=

# Path to service account JSON key file (alternative to ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------

# Redis URL for distributed rate limiting (optional)
# If not set, uses in-memory rate limiting
REDIS_URL=

# -----------------------------------------------------------------------------
# Development / Debug
# -----------------------------------------------------------------------------

# Log level: debug, info, warn, error (default: info)
NELLA_LOG_LEVEL=info
