{
  "permissions": {
    "allow": [
      "Bash(git rm:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm --filter @usenella/core build:*)",
      "Bash(pnpm --filter @getnella/mcp build:*)",
      "Bash(npx tsc:*)",
      "Bash(grep:*)",
      "Bash(export PATH=\"/c/Program Files/GitHub CLI:$PATH\")",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Read(//tmp/**)"
    ]
  },
  "mcpServers": {
    "nella": {
      "command": "npx",
      "args": ["-y", "@getnella/mcp"],
      "env": {
        "NELLA_REPO_PATH": "./"
      }
    }
  }
}


