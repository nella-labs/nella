# Security: prevent running arbitrary scripts from dependencies
ignore-scripts=true

# Allowlist packages that need postinstall (native bindings)
pnpm.onlyBuiltDependencies=["esbuild", "onnxruntime-node", "protobufjs"]

# Allow our own workspace scripts
enable-pre-post-scripts=true

# Strict peer dependency resolution
strict-peer-dependencies=false

# Use lockfile
frozen-lockfile=true
