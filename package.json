{
  "name": "nella-workspace",
  "version": "0.0.0",
  "description": "A monorepo containing a benchmark tool and Nella MCP",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "benchmark": "workspace:benchmark",
    "nella": "workspace:nella",
    "api": "workspace:api",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    "test:coverage": "pnpm -r test && echo Coverage reports generated in each package's coverage/ directory",
    "dev": "pnpm -r dev",
    "dev:api": "pnpm --filter @usenella/api dev",
    "build:api": "pnpm --filter @usenella/api build",
    "sync-docs": "tsx scripts/sync-docs.ts",
    "sync-docs:dry": "tsx scripts/sync-docs.ts --dry-run",
    "sync-docs:watch": "tsx scripts/sync-docs.ts --watch",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.3.4"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "c8": "^10.1.3",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.3.0"
  }
}
